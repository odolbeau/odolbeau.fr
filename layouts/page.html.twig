<!DOCTYPE html>
<html lang="{{ site.language }}">
    <head>
        {%- block head ~%}
            <meta charset="UTF-8">
            <meta http-equiv="X-UA-Compatible" content="IE=edge">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">

            {{- include('partials/metatags.html.twig', {page, site}, with_context = false) ~}}

            {#- Site-wide structured data: Person (Olivier Dolbeau) ~#}
            {%- block jsonld_person ~%}
            <script type="application/ld+json">{%- apply minify_js ~%}
            {
              "@context": "https://schema.org",
              "@type": "Person",
              "@id": "{{ url(site.home, {canonical: true}) }}#person",
              "name": "{{ site.author.name|e }}",
              "url": "{{ site.author.url|e }}",
              "jobTitle": "{{ site.baseline|e }}",
              "email": "{{ site.author.email|e }}",
              "image": "{{ url(asset('images/avatar-icon.png'), {canonical: true}) }}",
              "description": "{{ site.description|replace({"\n": ' '})|trim|e }}",
              "sameAs": [
                "https://github.com/odolbeau",
                "https://www.linkedin.com/in/olivier-dolbeau/",
                "https://stackoverflow.com/users/1080352/olivier-dolbeau",
                "https://www.openstreetmap.org/user/Babounet"
              ]
            }
            {%- endapply ~%}</script>
            {%- endblock jsonld_person ~%}

            <meta name="theme-color" media="(prefers-color-scheme: light)" content="white">
            <meta name="theme-color" media="(prefers-color-scheme: dark)" content="black">

            {%- block stylesheets ~%}
                <!-- Resource hints: warm up the connections for the third-party assets below -->
                <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>

                <!-- Bootstrap core CSS: render-blocking, needed for the above-the-fold layout (grid, nav) -->
                <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@3.3.7/dist/css/bootstrap.min.css" integrity="sha384-BVYiiSIFeK1dGmJRAkycuHAHRg32OmUcww7on3RYdg4Va+PmSTsz/K68vbdEjh4u" crossorigin="anonymous" referrerpolicy="no-referrer">

                <!-- Site CSS, bundled into a single request: also render-blocking, needed for above-the-fold layout/type -->
                <link rel="stylesheet" href="{{ asset(['css/main.css', 'css/fonts.css']) }}">

                <!-- Bootstrap theme CSS: purely cosmetic (gradients/shadows/border-radius only, no
                     layout-affecting rules), so it's loaded non-blocking via preload+swap instead of
                     sitting in the critical rendering path. Swapped to an active stylesheet by main.js;
                     <noscript> covers the no-JS case. -->
                <link rel="preload" as="style" data-defer-style href="https://cdn.jsdelivr.net/npm/bootstrap@3.3.7/dist/css/bootstrap-theme.min.css" integrity="sha384-rHyoN1iRsVXV4nD0JutlnGaslCJuC7uwjduW9SVrLvRYooPp2bWYgmgJQIXwl/Sp" crossorigin="anonymous" referrerpolicy="no-referrer">
                <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@3.3.7/dist/css/bootstrap-theme.min.css" integrity="sha384-rHyoN1iRsVXV4nD0JutlnGaslCJuC7uwjduW9SVrLvRYooPp2bWYgmgJQIXwl/Sp" crossorigin="anonymous" referrerpolicy="no-referrer"></noscript>
            {%- endblock stylesheets ~%}

        {%- endblock head ~%}
    </head>
    <body>
        <header>
            {%- block nav ~%}
                <nav class="navbar navbar-default navbar-fixed-top navbar-custom">
                    <div class="container-fluid">
                        <div class="navbar-header">
                            <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#main-navbar">
                                <span class="sr-only">Toggle navigation</span>
                                <span class="icon-bar"></span>
                                <span class="icon-bar"></span>
                                <span class="icon-bar"></span>
                            </button>
                            <a class="navbar-brand" href="/">{{ site.title }}</a>
                        </div>

                        <div class="collapse navbar-collapse" id="main-navbar">
                            <ul class="nav navbar-nav navbar-right">
                                <li><a href="/">About me</a></li>
                                <li><a href="/blog/">Blog</a></li>
                                <li><a href="/talks/">Talks</a></li>
                                <li><a href="mailto:{{ site.author.email }}">Contact</a></li>
                                <li><a href="/cv.pdf">CV <svg class="icon" viewBox="0 0 512 512" aria-hidden="true" focusable="false"><path fill="currentColor" d="M288 32c0-17.7-14.3-32-32-32s-32 14.3-32 32V274.7l-73.4-73.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l128 128c12.5 12.5 32.8 12.5 45.3 0l128-128c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L288 274.7V32zM64 352c-35.3 0-64 28.7-64 64v32c0 35.3 28.7 64 64 64H448c35.3 0 64-28.7 64-64V416c0-35.3-28.7-64-64-64H346.5l-45.3 45.3c-25 25-65.5 25-90.5 0L165.5 352H64zm368 56a24 24 0 1 1 0 48 24 24 0 1 1 0-48z"/></svg></a></li>
                            </ul>
                        </div>

                        <div class="avatar-container">
                            <div class="avatar-img-border">
                                <a href="/">
                                    <img class="avatar-img" src="{{ asset('images/avatar-icon.png') }}" />
                                </a>
                            </div>
                        </div>

                    </div>
                </nav>
            {%- endblock nav ~%}

            {%- block header ~%}
                <header class="header-section">
                    <div class="intro-header no-img">
                        <div class="container">
                            <div class="row">
                                <div class="col-lg-8 col-lg-offset-2 col-md-10 col-md-offset-1">
                                    <div class="page-heading">
                                        <h1>{{ page.title }}</h1>
                                        {% if page.subtitle is defined %}
                                        <hr class="small">
                                        <span class="page-subheading">{{ page.subtitle }}</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </header>
            {%- endblock header ~%}
        </header>
        <main class="container">
            {%- block content ~%}
                {{ page.content }}
            {%- endblock content ~%}
            {#- debug ~#}
            {%- if getenv('CECIL_DEBUG') %}{{ d(page) }}{% endif ~%}
        </main>
        <footer>
            {%- block footer ~%}
                <div class="container beautiful-jekyll-footer">
                    <div class="row">
                        <div class="col-lg-8 col-lg-offset-2 col-md-10 col-md-offset-1">
                            <ul class="list-inline text-center footer-links">
                                <li>
                                    <a href="https://github.com/odolbeau" title="GitHub" class="social-icon">
                                        <svg viewBox="0 0 496 512" aria-hidden="true" focusable="false"><path fill="currentColor" d="M165.9 397.4c0 2-2.3 3.6-5.2 3.6-3.3.3-5.6-1.3-5.6-3.6 0-2 2.3-3.6 5.2-3.6 3-.3 5.6 1.3 5.6 3.6zm-31.1-4.5c-.7 2 1.3 4.3 4.3 4.9 2.6 1 5.6 0 6.2-2s-1.3-4.3-4.3-5.2c-2.6-.7-5.5.3-6.2 2.3zm44.2-1.7c-2.9.7-4.9 2.6-4.6 4.9.3 2 2.9 3.3 5.9 2.6 2.9-.7 4.9-2.6 4.6-4.6-.3-1.9-3-3.2-5.9-2.9zM244.8 8C106.1 8 0 113.3 0 252c0 110.9 69.8 205.8 169.5 239.2 12.8 2.3 17.3-5.6 17.3-12.1 0-6.2-.3-40.4-.3-61.4 0 0-70 15-84.7-29.8 0 0-11.4-29.1-27.8-36.6 0 0-22.9-15.7 1.6-15.4 0 0 24.9 2 38.6 25.8 21.9 38.6 58.6 27.5 72.9 20.9 2.3-16 8.8-27.1 16-33.7-55.9-6.2-112.3-14.3-112.3-110.5 0-27.5 7.6-41.3 23.6-58.9-2.6-6.5-11.1-33.3 2.6-67.9 20.9-6.5 69 27 69 27 20-5.6 41.5-8.5 62.8-8.5s42.8 2.9 62.8 8.5c0 0 48.1-33.6 69-27 13.7 34.7 5.2 61.4 2.6 67.9 16 17.7 25.8 31.5 25.8 58.9 0 96.5-58.9 104.2-114.8 110.5 9.2 7.9 17 22.9 17 46.4 0 33.7-.3 75.4-.3 83.6 0 6.5 4.6 14.4 17.3 12.1C428.2 457.8 496 362.9 496 252 496 113.3 383.5 8 244.8 8zM97.2 352.9c-1.3 1-1 3.3.7 5.2 1.6 1.6 3.9 2.3 5.2 1 1.3-1 1-3.3-.7-5.2-1.6-1.6-3.9-2.3-5.2-1zm-10.8-8.1c-.7 1.3.3 2.9 2.3 3.9 1.6 1 3.6.7 4.3-.7.7-1.3-.3-2.9-2.3-3.9-2-.6-3.6-.3-4.3.7zm32.4 35.6c-1.6 1.3-1 4.3 1.3 6.2 2.3 2.3 5.2 2.6 6.5 1 1.3-1.3.7-4.3-1.3-6.2-2.2-2.3-5.2-2.6-6.5-1zm-11.4-14.7c-1.6 1-1.6 3.6 0 5.9 1.6 2.3 4.3 3.3 5.6 2.3 1.6-1.3 1.6-3.9 0-6.2-1.4-2.3-4-3.3-5.6-2z"/></svg>
                                    </a>
                                </li>
                                <li>
                                    <a href="https://www.linkedin.com/in/olivier-dolbeau/" title="LinkedIn" class="social-icon">
                                        <svg viewBox="0 0 448 512" aria-hidden="true" focusable="false"><path fill="currentColor" d="M100.28 448H7.4V148.9h92.88zm-46.44-338c-29.71 0-53.79-24.08-53.79-53.79C0 26.5 24.08 2.4 53.79 2.4s53.79 24.09 53.79 53.79c0 29.71-24.08 53.81-53.79 53.81zM447.9 448h-92.68V302.4c0-34.7-.7-79.3-48.29-79.3-48.29 0-55.7 37.7-55.7 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.7-48.3 87.9-48.3 94 0 111.28 61.9 111.28 142.3V448z"/></svg>
                                    </a>
                                </li>
                                <li>
                                    <a href="mailto:{{ site.author.email }}" title="Email me" class="social-icon">
                                        <svg viewBox="0 0 512 512" aria-hidden="true" focusable="false"><path fill="currentColor" d="M48 64C21.5 64 0 85.5 0 112c0 15.1 7.1 29.3 19.2 38.4L236.8 313.6c11.4 8.5 27 8.5 38.4 0L492.8 150.4c12.1-9.1 19.2-23.3 19.2-38.4c0-26.5-21.5-48-48-48L48 64zM0 176L0 384c0 35.3 28.7 64 64 64l384 0c35.3 0 64-28.7 64-64l0-208L294.4 339.2c-22.8 17.1-54 17.1-76.8 0L0 176z"/></svg>
                                    </a>
                                </li>
                                <li>
                                    <a href="https://stackoverflow.com/users/1080352/olivier-dolbeau" title="StackOverflow" class="social-icon">
                                        <svg viewBox="0 0 384 512" aria-hidden="true" focusable="false"><path fill="currentColor" d="M290.7 311L95 269.7 86.8 309l195.7 41zm51-87L188.2 95.7l-25.5 30.8 153.5 128.3zm-31.2 39.7L129.2 179l-16.7 36.5L293.7 300zM262 32l-32 24 119.3 160.3 32-24zm20.5 328h-200v39.7h200zm39.7 80H42.7V320h-40v160h359.5V320h-40z"/></svg>
                                    </a>
                                </li>
                                <li>
                                    <a href="{{ url(site.home, {format: 'atom'}) }}" title="RSS" class="social-icon">
                                        <svg viewBox="0 0 448 512" aria-hidden="true" focusable="false"><path fill="currentColor" d="M0 64C0 46.3 14.3 32 32 32c229.8 0 416 186.2 416 416c0 17.7-14.3 32-32 32s-32-14.3-32-32C384 253.6 226.4 96 32 96C14.3 96 0 81.7 0 64zM0 416a64 64 0 1 1 128 0A64 64 0 1 1 0 416zM32 160c159.1 0 288 128.9 288 288c0 17.7-14.3 32-32 32s-32-14.3-32-32c0-123.7-100.3-224-224-224c-17.7 0-32-14.3-32-32s14.3-32 32-32z"/></svg>
                                    </a>
                                </li>
                            </ul>
                            <p class="copyright text-muted">
                                Olivier Dolbeau
                                &nbsp;&bull;&nbsp;
                                {{ site.time | date('Y') }}

                                &nbsp;&bull;&nbsp;
                                <a href="{{ url(site.home) }}">odolbeau.fr</a>
                            </p>
                            <p class="theme-by text-muted">
                                Blog powered by
                                <a href="{{ cecil.url }}">{{ cecil.poweredby }}</a> -
                                Original theme by
                                <a href="http://deanattali.com/beautiful-jekyll/">beautiful-jekyll</a>
                            </p>
                        </div>
                    </div>
                </div>
            {%- endblock footer ~%}
        </footer>

        {% block javascripts %}
            <script src="{{ asset('js/main.js') }}" defer></script>
        {% endblock %}
    </body>
</html>
