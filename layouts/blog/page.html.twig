{% extends 'page.html.twig' %}

        {% block head %}
            {{ parent() }}
            {%- for p in site.allpages -%}
                {%- if page.reflang is defined and p.reflang is defined and p.reflang == page.reflang and p.lang != page.lang ~%}
            <link rel="alternate" hreflang="{{ p.lang }}" href="{{ url(p, {canonical: true}) }}">
                    {%- if p.lang == site.language -%}
                        {%- set defaultpage = p -%}
                    {%- else -%}
                        {%- set defaultpage = page -%}
                    {%- endif ~%}
            <link rel="alternate" hreflang="x-default" href="{{ url(defaultpage, {language: site.language, canonical: true}) }}">
                {%- endif ~%}
            {%- endfor ~%}

            {#- Structured data: BlogPosting (no "image" property: no post currently has a real
                qualifying image, and Google's Article guidelines require one when present, so it's
                omitted rather than faked with e.g. the avatar) ~#}
            {%- block jsonld_blogposting ~%}
            <script type="application/ld+json">{%- apply minify_js ~%}
            {
              "@context": "https://schema.org",
              "@type": "BlogPosting",
              "headline": "{{ page.title|e }}",
              {%- if page.description|default is not empty ~%}
              "description": "{{ page.description|replace({"\n": ' '})|trim|e }}",
              {%- endif ~%}
              "datePublished": "{{ page.date|date('c') }}",
              "dateModified": "{{ page.date|date('c') }}",
              "inLanguage": "{{ page.lang|default(site.language) }}",
              "url": "{{ url(page, {canonical: true}) }}",
              "author": {
                "@id": "{{ url(site.home, {canonical: true}) }}#person"
              },
              "publisher": {
                "@id": "{{ url(site.home, {canonical: true}) }}#person"
              }
              {%- if page.tags|default is not empty ~%},
              "keywords": "{{ page.tags|join(', ')|e }}"
              {%- endif ~%}
            }
            {%- endapply ~%}</script>
            {%- endblock jsonld_blogposting ~%}
        {% endblock head %}

{% block header %}
<header class="header-section">
    <div class="intro-header no-img">
        <div class="container">
            <div class="post-heading">
                <h1>{% if page.lang|default('en') == 'fr' %}🇫🇷{% else %}🇬🇧󠁧󠁢󠁥󠁮󠁧󠁿{% endif %} {{ page.title }}</h1>
                {% if page.subtitle is defined %}
                <hr class="small">
                <span class="post-subheading">{{ page.subtitle }}</span>
                {% endif %}

                <span class="post-meta">Posted on {{ page.date | date("F d, Y") }}</span>

                <div class="pull-right">
                    <a href="https://github.com/odolbeau/odolbeau.fr/edit/main/pages/blog/{{ page.date|date('Y-m-d') }}-{{ page.slug }}.md" class="btn btn-primary btn-xs">
                        <i class="fa-solid fa-pencil" aria-hideen="true"></i> Edit this post!
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>
{% endblock %}

{% block content %}
    <article role="main" class="blog-post" lang="{{ page.lang|default('en') }}">
        {% if date(page.date) < date('-1year') %}
            <div class="alert alert-warning">
                {%- if page.lang|default('en') == 'en' -%}
                    <h4>Outdated article!</h4>
                    If it's a technical article, take care, maybe some informations are not exact anymore.<br />
                    Otherwise, please keep in mind that this article was written quite a long time ago.
                {%- else -%}
                    <h4>Article potentiellement obsolète</h4>
                    S'il s'agit d'un article technique, attention, certains informations ne sont peut-être plus exactes.<br />
                    Autrement, merci de garder à l'esprit que cet article a été écrit il y a déjà un certain temps.
                {%- endif -%}
            </div>
        {% endif %}

        {{ parent() }}
    </article>

    {%- if page.tags -%}
    <div class="blog-tags">
        Tags: {{ page.tags | join(", ") }}
    </div>
    {%- endif -%}

    <ul class="pager blog-pager">
        {%- if page.prev is defined -%}
        <li class="previous">
            <a href="{{ url(page.prev) }}" data-toggle="tooltip" data-placement="top" title="{{ page.prev.title }}">&larr; Previous Post</a>
        </li>
        {%- endif -%}
        {%- if page.next is defined -%}
        <li class="next">
            <a href="{{ url(page.next) }}" data-toggle="tooltip" data-placement="top" title="{{ page.next.title }}">Next Post &rarr;</a>
        </li>
        {%- endif -%}
    </ul>
{% endblock content %}
